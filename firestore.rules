rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: reports
// Document ID: {reportId} (auto-generated ID)
// Fields:
//   - uid: string (required, immutable, matches request.auth.uid, 1..128 chars) - anonymous author UID
//   - intensity: string (required, immutable, in ['light', 'moderate', 'heavy', 'storm', 'stopped']) - rain intensity
//   - note: string | null (optional, immutable, max 140 chars if string) - short user observation
//   - lat: number (required, immutable, in [-90, 90]) - fuzzed latitude (100-200m offset)
//   - lng: number (required, immutable, in [-180, 180]) - fuzzed longitude (100-200m offset)
//   - geohash: string (required, immutable, 1..12 chars) - geohash prefix for spatial queries
//   - confirmCount: int (required, starts at 1 on create, increments by +1 on confirm vote)
//   - stoppedCount: int (required, starts at 0 on create, increments by +1 on stopped vote)
//   - createdAt: timestamp (required, immutable, equals request.time on create)
//   - expiresAt: timestamp (required, immutable, equals request.time + 30m on create, TTL field)
//
// Subcollection: reports/{reportId}/votes
// Document ID: {uid} (matches voter's request.auth.uid)
// Fields:
//   - type: string (required, immutable, in ['confirm', 'stopped']) - vote type
//   - createdAt: timestamp (required, immutable, equals request.time on create)
//
// Collection: rateLimits
// Document ID: {uid} (matches request.auth.uid)
// Fields:
//   - lastReportAt: timestamp (required, equals request.time, >= previous lastReportAt + 2m)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated (including Firebase Anonymous Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for UID-keyed documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return ('uid' in request.resource.data) &&
        request.resource.data.uid is string &&
        request.resource.data.uid.size() >= 1 &&
        request.resource.data.uid.size() <= 128 &&
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return ('uid' in request.resource.data) &&
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate optional note (omitted, null, or string <= 140 chars)
    function isValidOptionalNote(data) {
      return !('note' in data) ||
        data.note == null ||
        (data.note is string && data.note.size() <= 140);
    }

    // ===============================================================
    // Domain Validators (Used in both create and update)
    // ===============================================================

    function isValidReport(data) {
      let requiredFields = [
        'uid',
        'intensity',
        'lat',
        'lng',
        'geohash',
        'confirmCount',
        'stoppedCount',
        'createdAt',
        'expiresAt'
      ];
      let allowedFields = [
        'uid',
        'intensity',
        'note',
        'lat',
        'lng',
        'geohash',
        'geohash4',
        'confirmCount',
        'stoppedCount',
        'createdAt',
        'expiresAt'
      ];
      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.intensity is string &&
        data.intensity in ['light', 'moderate', 'heavy', 'storm', 'stopped'] &&
        isValidOptionalNote(data) &&
        data.lat is number &&
        data.lat >= -90 &&
        data.lat <= 90 &&
        data.lng is number &&
        data.lng >= -180 &&
        data.lng <= 180 &&
        data.geohash is string &&
        data.geohash.size() >= 1 &&
        data.geohash.size() <= 12 &&
        ('geohash4' in data
          ? (data.geohash4 is string &&
             data.geohash4.size() >= 1 &&
             data.geohash4.size() <= 12)
          : true) &&
        data.confirmCount is int &&
        data.confirmCount >= 1 &&
        data.stoppedCount is int &&
        data.stoppedCount >= 0 &&
        data.createdAt is timestamp &&
        data.expiresAt is timestamp;
    }

    function isWithinReportRateLimit() {
      let rateLimitPath = /databases/$(database)/documents/rateLimits/$(request.auth.uid);
      return (
        !exists(rateLimitPath) ||
        request.time >= get(rateLimitPath).data.lastReportAt + duration.value(2, 'm')
      ) &&
      getAfter(rateLimitPath).data.lastReportAt == request.time;
    }

    function isValidReportCounterUpdate(reportId) {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      let votePath = /databases/$(database)/documents/reports/$(reportId)/votes/$(request.auth.uid);
      let isConfirmIncrement = diffKeys.hasOnly(['confirmCount']) &&
        request.resource.data.confirmCount == resource.data.confirmCount + 1 &&
        getAfter(votePath).data.type == 'confirm';
      let isStoppedIncrement = diffKeys.hasOnly(['stoppedCount']) &&
        request.resource.data.stoppedCount == resource.data.stoppedCount + 1 &&
        getAfter(votePath).data.type == 'stopped';

      return (isConfirmIncrement || isStoppedIncrement) &&
        !exists(votePath) &&
        existsAfter(votePath);
    }

    function isValidVote(data) {
      return hasRequiredFields(['type', 'createdAt']) &&
        hasOnlyAllowedFields(['type', 'createdAt']) &&
        data.type is string &&
        data.type in ['confirm', 'stopped'] &&
        data.createdAt is timestamp &&
        data.createdAt == request.time;
    }

    function isValidRateLimit(data) {
      return hasRequiredFields(['lastReportAt']) &&
        hasOnlyAllowedFields(['lastReportAt']) &&
        data.lastReportAt is timestamp &&
        data.lastReportAt == request.time &&
        (
          resource == null ||
          request.time >= resource.data.lastReportAt + duration.value(2, 'm')
        );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /reports/{reportId} {
      // Reports are public, fuzzed 100-200m, and contain no PII; active window is filtered
      // client-side and expired documents are cleaned up by Firestore TTL. Avoiding
      // request.time here prevents live .snapshots() listeners from failing with
      // PERMISSION_DENIED on client clock skew or reconnects.
      allow read: if true;

      allow create: if isAuthenticated() &&
        isValidReport(request.resource.data) &&
        uidUnchanged() &&
        request.resource.data.confirmCount == 1 &&
        request.resource.data.stoppedCount == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt >= request.time + duration.value(28, 'm') &&
        request.resource.data.expiresAt <= request.time + duration.value(32, 'm') &&
        isWithinReportRateLimit();

      allow update: if isAuthenticated() &&
        resource.data.expiresAt > request.time &&
        isValidReport(request.resource.data) &&
        uidNotModified() &&
        isValidReportCounterUpdate(reportId);

      // Expired report cleanup is handled asynchronously by Firestore TTL
      allow delete: if false;

      match /votes/{uid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidVote(request.resource.data);
        allow update, delete: if false;
      }
    }

    match /rateLimits/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) && isValidRateLimit(request.resource.data);
      allow delete: if false;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
